<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.growmore.firebrowser">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".application.App"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_fire"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:persistent="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@drawable/ic_fire"
        android:supportsRtl="true"
        android:theme="@style/Theme.FireBrowser"
        android:usesCleartextTraffic="true"
        tools:replace="android:label,android:allowBackup">
        <activity
            android:name=".activity.main.SelectDownloadPathActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.tutorial.IntroActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.tutorial.TutorialOnlineVideoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.tutorial.TutorialInstaShareActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.tutorial.TutorialInstaCopyLinkActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.main.VideoPlayerActivity"
            android:configChanges="orientation|screenSize" />
        <activity
            android:name=".activity.browser.SearchEngineActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.download.DownloadLocationActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.download.DownloadSettingsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.browser.BrowseSettingActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.main.FeedbackActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.browser.HistoryActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.browser.BookmarkActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".activity.main.MainActivity"
            android:screenOrientation="portrait" >
        </activity>
        <activity
            android:name=".activity.main.SplashActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.browser.BrowserActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:label="@string/app_name"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustPan">
            <intent-filter android:icon="@drawable/ic_fire">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />

                <action android:name="sc_startPage" />
                <action android:name="sc_bookmark" />
                <action android:name="sc_history" />
            </intent-filter>

            <meta-data
                android:name="android.webkit.WebView.MetricsOptOut"
                android:value="true" />
        </activity>

        <meta-data
            android:name="com.google.android.gms.ads.AD_MANAGER_APP"
            android:value="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <service
            android:name=".service.NotificationService"
            android:stopWithTask="true"
            android:exported="false" />

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- Settings -->
        <activity
            android:name=".utils.browser.activity.Settings_Activity"
            android:label="@string/setting_label" />
        <activity
            android:name=".utils.browser.activity.Whitelist_Javascript"
            android:label="@string/setting_title_whitelistJS" />
        <activity
            android:name=".utils.browser.activity.Whitelist_Cookie"
            android:label="@string/setting_title_whitelistCookie" />
        <activity
            android:name=".utils.browser.activity.Whitelist_Remote"
            android:label="@string/setting_title_dom_whitelist" />
        <activity
            android:name=".utils.browser.activity.Settings_Delete"
            android:label="@string/menu_delete" />
        <activity
            android:name=".utils.browser.activity.Settings_StartActivity"
            android:label="@string/setting_title_start_control" />
        <activity
            android:name=".utils.browser.activity.Settings_Backup"
            android:label="@string/setting_title_data" />
        <activity
            android:name=".utils.browser.activity.Settings_UI"
            android:label="@string/setting_title_ui" />
        <activity
            android:name=".utils.browser.activity.Settings_Gesture"
            android:label="@string/setting_gestures" />
        <activity
            android:name=".utils.browser.activity.Settings_Filter"
            android:label="@string/setting_filter" />
    </application>

</manifest>