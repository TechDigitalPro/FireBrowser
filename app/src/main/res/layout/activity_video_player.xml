<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_color">


    <com.growmore.firebrowser.player.DoubleTapPlayerView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_color"/>
    <RelativeLayout
        android:id="@+id/lvUnLokView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <ImageView
            android:id="@+id/btPlayerUnLock"
            android:layout_width="@dimen/margin_50"
            android:layout_height="@dimen/margin_50"
            android:padding="@dimen/margin_15"
            android:src="@drawable/ic_lock"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_margin="@dimen/margin_20" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/lvPlayerGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_trans_back"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/lvBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="@dimen/margin_20"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_100"
                android:src="@drawable/ic_guide_vertical" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="@color/white_color"
                android:text="@string/txt_brightness"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lvVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="@dimen/margin_20"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_width="@dimen/margin_50"
                android:layout_height="@dimen/margin_100"
                android:src="@drawable/ic_guide_vertical" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="@color/white_color"
                android:text="@string/txt_volume"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_150"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true">
            <ImageView
                android:layout_width="@dimen/margin_100"
                android:layout_height="@dimen/margin_50"
                android:src="@drawable/ic_guide_horizontal" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:textColor="@color/white_color"
                android:text="@string/txt_progress"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>