<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:background="@color/colorPrimaryDark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/statusView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryDark"/>
            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/transparent_color"
                android:theme="@style/AppTheme.AppBarOverlay"
                app:elevation="0dp">
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:contentInsetLeft="0dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                    <LinearLayout
                        android:id="@+id/toolbarView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/colorPrimaryDark">

                        <LinearLayout
                            android:id="@+id/toolbarBrowse"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:visibility="visible">
                            <ImageView
                                android:id="@+id/toolbarBrowseBack"
                                android:layout_width="@dimen/bottom_icon_size"
                                android:layout_height="@dimen/bottom_icon_size"
                                android:padding="@dimen/padding_5"
                                android:src="@drawable/ic_arrow_back"/>
                            <ImageView
                                android:id="@+id/toolbarBrowseForward"
                                android:layout_width="@dimen/bottom_icon_size"
                                android:layout_height="@dimen/bottom_icon_size"
                                android:padding="@dimen/padding_5"
                                android:src="@drawable/ic_arrow_next"/>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_margin="@dimen/margin_5"
                                android:paddingStart="@dimen/padding_5"
                                android:paddingEnd="@dimen/padding_5"
                                android:background="@drawable/bk_search_bar">
                                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                    android:id="@+id/toolbarBrowseSearch"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:padding="@dimen/margin_10"
                                    android:hint="@string/txt_watch_free_videos"
                                    android:textColor="@color/white_color"
                                    android:textColorHint="@color/grey_light"
                                    android:background="@android:color/transparent"
                                    android:imeOptions="actionDone"
                                    android:inputType="textUri"
                                    android:singleLine="true"
                                    android:selectAllOnFocus="true"
                                    android:ellipsize="start"
                                    android:textSize="@dimen/text_12"/>
                                <ImageView
                                    android:id="@+id/toolbarBrowseSearchReload"
                                    android:layout_width="@dimen/bottom_icon_size"
                                    android:layout_height="@dimen/bottom_icon_size"
                                    android:padding="@dimen/padding_5"
                                    android:src="@drawable/ic_reload"/>
                            </LinearLayout>

                        </LinearLayout>
                        <RelativeLayout
                            android:id="@+id/toolbarTabBtn"
                            android:layout_width="@dimen/sidebar_icon_size"
                            android:layout_height="@dimen/sidebar_icon_size">
                            <ImageView
                                android:id="@+id/toolbarTabs"
                                android:layout_width="@dimen/sidebar_icon_size"
                                android:layout_height="@dimen/sidebar_icon_size"
                                android:padding="@dimen/padding_10"
                                android:src="@drawable/ic_tabs"
                                android:visibility="gone"/>
                            <ImageView
                                android:id="@+id/toolbarTabSingle"
                                android:layout_width="@dimen/sidebar_icon_size"
                                android:layout_height="@dimen/sidebar_icon_size"
                                android:paddingStart="@dimen/margin_9"
                                android:paddingTop="@dimen/margin_9"
                                android:paddingBottom="@dimen/margin_11"
                                android:paddingEnd="@dimen/margin_11"
                                android:src="@drawable/ic_tab"
                                android:visibility="visible"/>
                            <TextView
                                android:id="@+id/toolbarTabsCount"
                                android:layout_width="@dimen/sidebar_icon_size"
                                android:layout_height="@dimen/sidebar_icon_size"
                                android:paddingBottom="@dimen/margin_2"
                                android:paddingEnd="@dimen/margin_2"
                                android:gravity="center"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimaryDark"
                                android:text="1"
                                app:autoSizeMaxTextSize="@dimen/text_10"
                                app:autoSizeMinTextSize="@dimen/text_8"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform" />
                        </RelativeLayout>

                        <ImageView
                            android:id="@+id/toolbarMore"
                            android:layout_width="@dimen/sidebar_icon_size"
                            android:layout_height="@dimen/sidebar_icon_size"
                            android:padding="@dimen/padding_10"
                            android:src="@drawable/ic_more_3_dot"/>
                    </LinearLayout>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.AppBarLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:id="@+id/mainContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
                <com.growmore.firebrowser.utils.MovableFloatingActionButton
                    android:id="@+id/btDownload"
                    android:layout_width="@dimen/item_link_image_size"
                    android:layout_height="@dimen/item_link_image_size"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="@dimen/margin_20"
                    android:background="@drawable/ic_download_btn" />
            </RelativeLayout>
            <include layout="@layout/layout_bottom_navigation"/>
        </LinearLayout>

    </LinearLayout>
    <RelativeLayout
        android:id="@+id/lvCoverView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_trans_back"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"/>

</RelativeLayout>