<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimaryDark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/btBack"
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:src="@drawable/ic_arrow_back"
            android:padding="@dimen/padding_15"/>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_20"
            android:textColor="@color/white_color"
            android:text="@string/txt_move_to"/>

    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/grey_light"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/lvButtonView"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/white_10">
                <TextView
                    android:id="@+id/fp_tv_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/padding_10"
                    android:paddingEnd="@dimen/padding_2"
                    android:paddingTop="@dimen/padding_10"
                    android:paddingBottom="@dimen/padding_10"
                    android:scrollbars="vertical"
                    android:singleLine="true"
                    android:text="@string/txt_internal_storage"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_15"/>
                <ImageView
                    android:layout_width="@dimen/checkbox_icon_size"
                    android:layout_height="@dimen/checkbox_icon_size"
                    android:padding="@dimen/padding_5"
                    android:src="@drawable/ic_arrow_next"
                    app:tint="@color/colorAccent"/>
            </LinearLayout>


            <ListView
                android:id="@+id/fp_listView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_weight="1" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/lvButtonView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:background="@color/white_10">
            <TextView
                android:id="@+id/btCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="@dimen/padding_10"
                android:gravity="center"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_15"
                android:text="@string/txt_cancel"/>
            <TextView
                android:id="@+id/btMove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="@dimen/padding_10"
                android:gravity="center"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_15"
                android:text="@string/txt_move"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
