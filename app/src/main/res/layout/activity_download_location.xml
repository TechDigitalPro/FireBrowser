<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimaryDark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/btBack"
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:padding="@dimen/padding_15"
            android:src="@drawable/ic_arrow_back"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_20"
            android:textColor="@color/white_color"
            android:text="@string/txt_download_location"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/grey_light"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/lvDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/margin_10">
            <LinearLayout
                android:id="@+id/lvPrivateFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/padding_20">
                <ImageView
                    android:layout_width="@dimen/item_link_image_size"
                    android:layout_height="@dimen/item_link_image_size"
                    android:src="@drawable/ic_private_folder"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/padding_10"
                    android:layout_marginEnd="@dimen/padding_10">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_15"
                        android:textColor="@color/grey_light"
                        android:textStyle="bold"
                        android:text="@string/txt_private_folder"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/grey_light"
                        android:text="@string/txt_downloaded_files_can_only_be_accessed_through_this_app"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/chkPrivate"
                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    app:tint="@color/grey_light"
                    android:src="@drawable/ic_checkbox_unchecked"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/lvPublicFolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/padding_20">
                <ImageView
                    android:layout_width="@dimen/item_link_image_size"
                    android:layout_height="@dimen/item_link_image_size"
                    android:src="@drawable/ic_public_folder"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/padding_10"
                    android:layout_marginEnd="@dimen/padding_10">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_15"
                        android:textColor="@color/grey_light"
                        android:textStyle="bold"
                        android:text="@string/txt_public_folder"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/grey_light"
                        android:text="@string/txt_downloaded_files_available_from_phone_gallery"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/chkPublic"
                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    app:tint="@color/grey_light"
                    android:src="@drawable/ic_checkbox_unchecked"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>