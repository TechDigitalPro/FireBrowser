<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimaryDark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="@dimen/margin_20">
        <ImageView
            android:id="@+id/btClose"
            android:layout_width="@dimen/sidebar_icon_size"
            android:layout_height="@dimen/sidebar_icon_size"
            android:layout_gravity="end"
            android:padding="@dimen/padding_10"
            android:src="@drawable/ic_close"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.growmore.firebrowser.utils.RtlViewPager
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <RelativeLayout
                android:id="@+id/lvBottom"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_alignParentBottom="true">
                <LinearLayout
                    android:id="@+id/lvNextView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:id="@+id/lvDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    </LinearLayout>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:id="@+id/btNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/padding_50"
                        android:paddingEnd="@dimen/padding_50"
                        android:paddingTop="@dimen/padding_7"
                        android:paddingBottom="@dimen/padding_7"
                        android:background="@drawable/bk_button_gradient_round"
                        android:textColor="@color/white_color"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold"
                        android:text="@string/txt_next"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lvEnterView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/btEnter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding_10"
                        android:gravity="center"
                        android:background="@drawable/bk_button_gradient_rect"
                        android:textColor="@color/white_color"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold"
                        android:text="@string/txt_enter"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>