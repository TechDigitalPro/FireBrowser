<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimaryDark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/btBack"
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:padding="@dimen/padding_15"
            android:src="@drawable/ic_arrow_back"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_20"
            android:textColor="@color/white_color"
            android:text="@string/txt_download_settings"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/grey_light"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/lvDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="@dimen/margin_10">
            <com.growmore.firebrowser.utils.MenuItemSetting
                android:id="@+id/itemDownloadLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:inf_icon="@drawable/ic_directory"
                app:inf_hidde_icon_subcription="false"
                app:inf_title="@string/txt_download_location"
                app:inf_description="@string/txt_private_holder_"/>
            <com.growmore.firebrowser.utils.MenuItemSetting
                android:id="@+id/itemWifiOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:inf_icon="@drawable/ic_wifi"
                app:inf_show_switch_check="true"
                app:inf_title="@string/txt_download_wifi_only" />
            <com.growmore.firebrowser.utils.MenuItemSetting
                android:id="@+id/itemRingtone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:inf_icon="@drawable/ic_notification"
                app:inf_show_switch_check="true"
                app:inf_title="@string/txt_download_complete_ringtone" />
            <com.growmore.firebrowser.utils.MenuItemSetting
                android:id="@+id/itemVibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:inf_icon="@drawable/ic_vibration"
                app:inf_show_switch_check="true"
                app:inf_title="@string/txt_download_complete_vibration" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_10">
                <ImageView
                    android:layout_width="@dimen/sidebar_icon_size"
                    android:layout_height="@dimen/sidebar_icon_size"
                    android:padding="@dimen/padding_10"
                    android:src="@drawable/ic_storage"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/grey_light"
                        android:textSize="@dimen/text_15"
                        android:text="@string/txt_available_storage"/>
                    <ProgressBar
                        android:id="@+id/progressStorage"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_8"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/bk_progress_bar"
                        android:visibility="visible"
                        android:layout_marginTop="@dimen/padding_10"
                        android:layout_marginBottom="@dimen/padding_10"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="@dimen/padding_10"
                            android:layout_height="@dimen/padding_10"
                            android:background="@drawable/bk_button_gradient_round"/>
                        <TextView
                            android:id="@+id/tvUsedStorage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/grey_light"
                            android:text="@string/txt_f_gb_free"
                            android:layout_marginStart="@dimen/margin_10"/>
                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:id="@+id/tvTotalStorage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/grey_light"
                            android:text="@string/txt_f_gb_total"
                            android:layout_marginEnd="@dimen/margin_10"/>
                        <TextView
                            android:layout_width="@dimen/padding_10"
                            android:layout_height="@dimen/padding_10"
                            android:background="@drawable/bk_button_round_grey_light"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>