<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrimaryDark"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimaryDark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btSearchClose"
                    android:layout_width="?attr/actionBarSize"
                    android:layout_height="?attr/actionBarSize"
                    android:padding="@dimen/margin_15"
                    android:src="@drawable/ic_arrow_back" />

                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                    android:id="@+id/searchBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/margin_5"
                    android:hint="@string/search_hint"
                    android:textColor="@color/white_color"
                    android:textColorHint="@color/grey_light"
                    android:background="@android:color/transparent"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:selectAllOnFocus="true"
                    android:ellipsize="start"
                    android:textSize="@dimen/text_15"/>

                <ImageView
                    android:id="@+id/btSearchClear"
                    android:layout_width="@dimen/checkbox_icon_size"
                    android:layout_height="@dimen/checkbox_icon_size"
                    android:layout_marginEnd="@dimen/margin_15"
                    android:background="@drawable/bk_button_round_white_10"
                    android:padding="@dimen/padding_5"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:background="@color/grey_light" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvSearchResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:padding="@dimen/padding_10"
            android:text="@string/txt_search_result_d"
            android:textColor="@color/grey_light"
            android:textSize="@dimen/text_12" />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>