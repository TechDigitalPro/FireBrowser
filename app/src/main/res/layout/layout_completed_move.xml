<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrimaryDark"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="visible">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimaryDark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btMoveClose"
                    android:layout_width="?attr/actionBarSize"
                    android:layout_height="?attr/actionBarSize"
                    android:padding="@dimen/margin_15"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    android:id="@+id/tvMoveSelected"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_15"
                    android:textColor="@color/white_color"
                    android:text="@string/txt_d_selected"/>
                <CheckBox
                    android:id="@+id/chkMoveAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/padding_5"
                    android:paddingEnd="@dimen/padding_5"
                    android:buttonTint="@color/colorAccent"
                    android:text="@string/txt_all"
                    android:textSize="@dimen/text_15"
                    android:textColor="@color/white_color"/>
                <ImageView
                    android:id="@+id/btMove"
                    android:layout_width="@dimen/sidebar_icon_size"
                    android:layout_height="@dimen/sidebar_icon_size"
                    android:layout_marginEnd="@dimen/margin_10"
                    android:padding="@dimen/padding_10"
                    android:src="@drawable/ic_move" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:background="@color/grey_light" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewMove"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>