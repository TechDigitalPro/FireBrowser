<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimaryDark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/btBack"
            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"
            android:padding="@dimen/padding_15"
            android:src="@drawable/ic_arrow_back"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_20"
            android:textColor="@color/white_color"
            android:text="@string/txt_settings"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/grey_light"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/lvDownload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="@dimen/margin_10">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/padding_5"
                        android:textColor="@color/grey_light"
                        android:textSize="@dimen/text_12"
                        android:text="@string/txt_download"/>
                    <com.growmore.firebrowser.utils.MenuItemSetting
                        android:id="@+id/itemDownloadLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:inf_icon="@drawable/ic_directory"
                        app:inf_hidde_icon_subcription="false"
                        app:inf_title="@string/txt_download_location"
                        app:inf_description="@string/txt_private_holder_"/>
                    <com.growmore.firebrowser.utils.MenuItemSetting
                        android:id="@+id/itemWifiOnly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:inf_icon="@drawable/ic_wifi"
                        app:inf_show_switch_check="true"
                        app:inf_title="@string/txt_download_wifi_only" />
                    <com.growmore.firebrowser.utils.MenuItemSetting
                        android:id="@+id/itemRingtone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:inf_icon="@drawable/ic_notification"
                        app:inf_show_switch_check="true"
                        app:inf_title="@string/txt_download_complete_ringtone" />
                    <com.growmore.firebrowser.utils.MenuItemSetting
                        android:id="@+id/itemVibration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:inf_icon="@drawable/ic_vibration"
                        app:inf_show_switch_check="true"
                        app:inf_title="@string/txt_download_complete_vibration" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lvBrowser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="@color/grey_light"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_margin="@dimen/margin_10">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/padding_5"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_12"
                            android:text="@string/txt_browser"/>
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemDefaultBrowser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_browser"
                            app:inf_show_switch_check="true"
                            app:inf_title="@string/txt_set_as_default_browser" />
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemSearchEngine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_browser_download"
                            app:inf_hidde_icon_subcription="false"
                            app:inf_title="Search Engine"
                            app:inf_description="Google"/>
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemAutoConnect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_vpn_connect"
                            app:inf_show_switch_check="true"
                            app:inf_title="@string/txt_auto_vpn_connect" />
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemBlockAds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_block_ad"
                            app:inf_show_switch_check="true"
                            app:inf_title="@string/txt_block_ads" />
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemIncognitoMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_incognito"
                            app:inf_show_switch_check="true"
                            app:inf_title="@string/txt_incognito_mode" />
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemClearCache"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_clear_cache"
                            app:inf_title="@string/txt_clear_cache" />
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemNotificationSetting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_notification"
                            app:inf_hidde_icon_subcription="false"
                            app:inf_title="@string/txt_notification_settings"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lvAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="@color/grey_light"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_margin="@dimen/margin_10">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/padding_5"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_12"
                            android:text="@string/txt_about"/>
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemRateApp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_rate_app"
                            app:inf_hidde_icon_subcription="false"
                            app:inf_title="@string/txt_rate_our_app"/>
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemHelpFeedback"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_help"
                            app:inf_hidde_icon_subcription="false"
                            app:inf_title="@string/txt_help_and_feedback"/>
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemShareApp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_share"
                            app:inf_hidde_icon_subcription="false"
                            app:inf_title="@string/txt_share_app"/>
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemUserAgreement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_user_agreement"
                            app:inf_hidde_icon_subcription="false"
                            app:inf_title="@string/txt_user_agreement"/>
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemPrivacy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_privacy_policy"
                            app:inf_hidde_icon_subcription="false"
                            app:inf_title="@string/txt_privacy_policy"/>
                        <com.growmore.firebrowser.utils.MenuItemSetting
                            android:id="@+id/itemUpdate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:inf_icon="@drawable/ic_update"
                            app:inf_hidde_icon_subcription="false"
                            app:inf_title="@string/txt_update"
                            app:inf_description="v 1.0.0"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</LinearLayout>