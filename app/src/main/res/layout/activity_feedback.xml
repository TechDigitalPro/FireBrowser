<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimaryDark">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/btBack"
                android:layout_width="?attr/actionBarSize"
                android:layout_height="?attr/actionBarSize"
                android:src="@drawable/ic_arrow_back"
                android:padding="@dimen/padding_15"/>
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_20"
                android:textColor="@color/white_color"
                android:text="@string/txt_help_and_feedback"/>

        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/grey_light"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/margin_20">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_15"
                    android:textColor="@color/white_color"
                    android:text="@string/txt_please_write_your_feedback"/>
                <EditText
                    android:id="@+id/edtFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/padding_20"
                    android:paddingEnd="@dimen/padding_20"
                    android:paddingTop="@dimen/padding_10"
                    android:paddingBottom="@dimen/padding_10"
                    android:layout_marginTop="@dimen/margin_20"
                    android:hint="@string/txt_type_here"
                    android:textColor="@color/white_color"
                    android:textColorHint="@color/grey_light"
                    android:inputType="textCapSentences|textMultiLine"
                    android:textSize="@dimen/text_15"
                    android:background="@drawable/bk_grey_circle"
                    android:minHeight="@dimen/margin_45"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_250"
                    android:layout_marginTop="@dimen/margin_20"
                    android:background="@drawable/bk_grey_stroke"
                    android:padding="@dimen/padding_5">
                    <LinearLayout
                        android:id="@+id/lvAddImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="?attr/actionBarSize"
                            android:layout_height="?attr/actionBarSize"
                            android:src="@drawable/ic_photo"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_18"
                            android:padding="@dimen/padding_10"
                            android:text="@string/txt_add_screenshot"
                            android:textColor="@color/white_color"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/imgFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                </RelativeLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20"
                    android:textSize="@dimen/text_15"
                    android:textColor="@color/white_color"
                    android:text="@string/txt_your_system_info_will_be_sent_to"/>
                <TextView
                    android:id="@+id/btSend"
                    android:layout_width="@dimen/margin_200"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_10"
                    android:background="@drawable/bk_button_gradient_rect"
                    android:gravity="center"
                    android:textColor="@color/white_color"
                    android:textSize="@dimen/text_15"
                    android:text="@string/txt_send"
                    android:layout_marginTop="@dimen/margin_20"
                    android:layout_gravity="center_horizontal"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</LinearLayout>