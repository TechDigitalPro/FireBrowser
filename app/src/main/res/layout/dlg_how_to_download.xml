<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/margin_20"
    android:orientation="vertical"
    app:cardCornerRadius="@dimen/margin_10"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/colorPrimaryDark">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_200"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_how_to_header" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin_190"
                android:background="@color/colorPrimaryDark"
                android:padding="@dimen/padding_10">
                <LinearLayout
                    android:id="@+id/lvDownloadInstaVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/padding_10">
                    <TextView
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:background="@drawable/bk_button_yellow"
                        android:gravity="center"
                        android:text="1"
                        android:textSize="@dimen/text_20"
                        android:textColor="@color/white_color"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/padding_15"
                        android:layout_marginEnd="@dimen/padding_10"
                        android:textColor="@color/grey_light"
                        android:textSize="@dimen/text_15"
                        android:text="@string/txt_how_to_download_instagram_videos"/>
                    <ImageView
                        android:layout_width="@dimen/bottom_icon_size"
                        android:layout_height="@dimen/bottom_icon_size"
                        android:padding="@dimen/margin_5"
                        android:src="@drawable/ic_arrow_next"
                        app:tint="@color/grey_light"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginStart="@dimen/margin_10"
                    android:layout_marginEnd="@dimen/margin_10"
                    android:background="@color/grey_light"/>
                <LinearLayout
                    android:id="@+id/lvDownloadShareInstaVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/padding_10">
                    <TextView
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:background="@drawable/bk_button_purple"
                        android:gravity="center"
                        android:text="2"
                        android:textSize="@dimen/text_20"
                        android:textColor="@color/white_color"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/padding_15"
                        android:layout_marginEnd="@dimen/padding_10"
                        android:textColor="@color/grey_light"
                        android:textSize="@dimen/text_15"
                        android:text="@string/txt_how_to_download_and_share_instagram_videos"/>
                    <ImageView
                        android:layout_width="@dimen/bottom_icon_size"
                        android:layout_height="@dimen/bottom_icon_size"
                        android:padding="@dimen/margin_5"
                        android:src="@drawable/ic_arrow_next"
                        app:tint="@color/grey_light"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginStart="@dimen/margin_10"
                    android:layout_marginEnd="@dimen/margin_10"
                    android:background="@color/grey_light"/>
                <LinearLayout
                    android:id="@+id/lvDownloadOnlineVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/padding_10">
                    <TextView
                        android:layout_width="@dimen/margin_40"
                        android:layout_height="@dimen/margin_40"
                        android:background="@drawable/bk_button_blue"
                        android:gravity="center"
                        android:text="3"
                        android:textSize="@dimen/text_20"
                        android:textColor="@color/white_color"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/padding_15"
                        android:layout_marginEnd="@dimen/padding_10"
                        android:textColor="@color/grey_light"
                        android:textSize="@dimen/text_15"
                        android:text="@string/txt_how_to_download_videos_online"/>
                    <ImageView
                        android:layout_width="@dimen/bottom_icon_size"
                        android:layout_height="@dimen/bottom_icon_size"
                        android:padding="@dimen/margin_5"
                        android:src="@drawable/ic_arrow_next"
                        app:tint="@color/grey_light"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/btClose"
            android:layout_width="@dimen/bottom_icon_size"
            android:layout_height="@dimen/bottom_icon_size"
            android:padding="@dimen/margin_5"
            android:layout_margin="@dimen/margin_10"
            android:src="@drawable/ic_close"
            app:tint="@color/grey_dark"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>