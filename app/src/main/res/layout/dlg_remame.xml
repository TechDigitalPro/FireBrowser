<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/margin_20"
    android:orientation="vertical"
    app:cardCornerRadius="@dimen/margin_10"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/colorPrimaryDark">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/padding_20"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_18"
                android:textStyle="bold"
                android:text="@string/txt_rename"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/grey_light"
                android:layout_marginTop="@dimen/margin_10"
                android:layout_marginBottom="@dimen/margin_10"/>
            <EditText
                android:id="@+id/edtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/padding_20"
                android:paddingEnd="@dimen/padding_20"
                android:paddingTop="@dimen/padding_10"
                android:paddingBottom="@dimen/padding_10"
                android:layout_marginTop="@dimen/margin_20"
                android:hint="@string/txt_type_here"
                android:textColor="@color/white_color"
                android:textColorHint="@color/grey_light"
                android:inputType="textCapSentences|textMultiLine"
                android:textSize="@dimen/text_15"
                android:background="@drawable/bk_grey_circle"
                android:minHeight="@dimen/margin_45"/>
            <TextView
                android:id="@+id/btSave"
                android:layout_width="@dimen/margin_200"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_10"
                android:background="@drawable/bk_button_gradient_rect"
                android:gravity="center"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_15"
                android:text="@string/txt_save"
                android:layout_marginTop="@dimen/margin_20"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btClose"
            android:layout_width="@dimen/checkbox_icon_size"
            android:layout_height="@dimen/checkbox_icon_size"
            android:padding="@dimen/margin_5"
            android:layout_margin="@dimen/margin_10"
            android:background="@drawable/bk_grey_circle"
            android:src="@drawable/ic_close"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>