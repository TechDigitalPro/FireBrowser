<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/margin_250"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingEnd="@dimen/margin_10"
    android:paddingStart="@dimen/margin_10">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bk_dropdown">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/margin_15"
                android:paddingEnd="@dimen/margin_15"
                android:paddingTop="@dimen/margin_20"
                android:paddingBottom="@dimen/margin_20">
                <com.growmore.firebrowser.utils.MenuItemInformation
                    android:id="@+id/itemDelete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:inf_icon="@drawable/ic_delete"
                    app:inf_title="@string/txt_delete" />
                <com.growmore.firebrowser.utils.MenuItemInformation
                    android:id="@+id/itemMove"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:inf_icon="@drawable/ic_move"
                    app:inf_title="@string/txt_move" />
                <com.growmore.firebrowser.utils.MenuItemInformation
                    android:id="@+id/itemSort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:inf_icon="@drawable/ic_sort"
                    app:inf_icon_sub="@drawable/ic_arrow_down"
                    app:inf_title="@string/txt_sort_by" />
                <LinearLayout
                    android:id="@+id/lvSortBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/margin_10"
                    android:layout_marginStart="@dimen/margin_10"
                    android:layout_marginEnd="@dimen/margin_20"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/lvByDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="@dimen/padding_5"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_15"
                            android:text="@string/txt_date"/>
                        <ImageView
                            android:id="@+id/chkByDate"
                            android:layout_width="@dimen/checkbox_icon_size"
                            android:layout_height="@dimen/checkbox_icon_size"
                            android:src="@drawable/ic_select"
                            android:visibility="invisible"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/lvByName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="@dimen/padding_5"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_15"
                            android:text="@string/txt_name"/>
                        <ImageView
                            android:id="@+id/chkByName"
                            android:layout_width="@dimen/checkbox_icon_size"
                            android:layout_height="@dimen/checkbox_icon_size"
                            android:src="@drawable/ic_select"
                            android:visibility="invisible"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/lvBySize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="@dimen/padding_5"
                            android:textColor="@color/grey_light"
                            android:textSize="@dimen/text_15"
                            android:text="@string/txt_size"/>
                        <ImageView
                            android:id="@+id/chkBySize"
                            android:layout_width="@dimen/checkbox_icon_size"
                            android:layout_height="@dimen/checkbox_icon_size"
                            android:src="@drawable/ic_select"
                            android:visibility="invisible"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>