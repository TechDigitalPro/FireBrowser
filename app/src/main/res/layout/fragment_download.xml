<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorPrimaryDark">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/transparent_color"
                android:theme="@style/AppTheme.AppBarOverlay"
                app:elevation="0dp">
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:contentInsetLeft="0dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:id="@+id/toolbarView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_20"
                                android:layout_weight="1"
                                android:text="@string/txt_download"
                                android:textColor="@color/white_color"
                                android:textSize="@dimen/text_20" />

                            <ImageView
                                android:id="@+id/toolbarSettings"
                                android:layout_width="@dimen/sidebar_icon_size"
                                android:layout_height="@dimen/sidebar_icon_size"
                                android:padding="@dimen/padding_10"
                                android:src="@drawable/ic_settings" />

                            <ImageView
                                android:id="@+id/toolbarMore"
                                android:layout_width="@dimen/sidebar_icon_size"
                                android:layout_height="@dimen/sidebar_icon_size"
                                android:padding="@dimen/padding_10"
                                android:src="@drawable/ic_more_3_dot" />
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.AppBarLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/margin_5">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none" />
                    <LinearLayout
                        android:id="@+id/lvBlankView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_alignParentBottom="true"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="@dimen/empty_image_size"
                            android:layout_height="@dimen/empty_image_size"
                            android:src="@drawable/ic_empty_downloads"
                            android:layout_margin="@dimen/margin_20"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="@dimen/text_15"
                            android:textColor="@color/grey_light"
                            android:textStyle="bold"
                            android:text="@string/txt_your_download_files_visible_in_this_app_only"
                            android:layout_margin="@dimen/margin_10"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="@dimen/text_12"
                            android:textColor="@color/grey_light"
                            android:text="@string/txt_to_keep_it_private_files_are_downloaded_to_private_folder"
                            android:layout_marginStart="@dimen/margin_20"
                            android:layout_marginEnd="@dimen/margin_20"/>
                        <TextView
                            android:id="@+id/btHowToDownload"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/padding_10"
                            android:layout_margin="@dimen/margin_20"
                            android:gravity="center"
                            android:background="@drawable/bk_button_gradient_rect"
                            android:textSize="@dimen/text_15"
                            android:textColor="@color/white_color"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:text="@string/txt_how_to_download"/>
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/lvCoverView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grey_trans_back"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>
    </RelativeLayout>
</LinearLayout>