<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/lvTopToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/btBack"
                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    android:src="@drawable/ic_back"
                    android:padding="@dimen/padding_5"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/btCopy"
                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    android:src="@drawable/ic_copy_link"
                    android:padding="@dimen/padding_5"
                    android:layout_marginEnd="@dimen/margin_10"/>
                <ImageView
                    android:id="@+id/btShare"
                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    android:src="@drawable/ic_share"
                    android:padding="@dimen/padding_5"
                    android:layout_marginEnd="@dimen/margin_10"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/btVolume"
                android:layout_width="@dimen/bottom_icon_size"
                android:layout_height="@dimen/bottom_icon_size"
                android:src="@drawable/ic_volume_down"
                android:padding="@dimen/padding_5"
                android:layout_marginEnd="@dimen/margin_10"
                android:layout_gravity="end"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/margin_10">
                <LinearLayout
                    android:id="@+id/exo_center_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:background="@android:color/transparent"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/delete"
                        style="@style/ExoStyledControls.Button.Center.Secondary"
                        android:src="@drawable/exo_styled_controls_delete" />

                    <ImageButton
                        android:id="@+id/exo_prev"
                        android:visibility="gone"
                        style="@style/ExoStyledControls.Button.Center.Previous" />

                    <ImageView
                        android:id="@+id/exo_bt_lock"
                        android:layout_width="@dimen/margin_30"
                        android:layout_height="@dimen/margin_30"
                        android:src="@drawable/ic_lock"
                        android:padding="@dimen/padding_5"
                        android:layout_margin="@dimen/margin_15"/>
                    <ImageView
                        android:id="@+id/btRewind_5"
                        android:layout_width="@dimen/margin_50"
                        android:layout_height="@dimen/margin_50"
                        android:padding="@dimen/padding_15"
                        android:src="@drawable/ic_forward_five"/>
                    <Button
                        android:visibility="gone"
                        android:id="@id/exo_rew_with_amount"
                        android:foreground="@drawable/ic_back_five"
                        android:backgroundTint="@android:color/white"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:gravity="center|bottom"
                        android:layout_width="@dimen/margin_25"
                        android:layout_height="@dimen/margin_25"
                        android:layout_margin="@dimen/padding_15"
                        android:textSize="0dp"/>

                    <ImageButton
                        android:id="@+id/exo_play_pause"
                        style="@style/ExoStyledControls.Button.Center.PlayPause"
                        android:layout_width="@dimen/margin_70"
                        android:layout_height="@dimen/margin_70"
                        android:layout_marginStart="@dimen/margin_15"
                        android:layout_marginEnd="@dimen/margin_15"/>

                    <ProgressBar
                        android:id="@+id/loading"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <Button
                        android:visibility="gone"
                        android:id="@id/exo_ffwd_with_amount"
                        android:foreground="@drawable/ic_forward_five"
                        android:backgroundTint="@android:color/white"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:gravity="center|bottom"
                        android:layout_width="@dimen/margin_25"
                        android:layout_height="@dimen/margin_25"
                        android:layout_margin="@dimen/padding_15"
                        android:textSize="0dp"/>
                    <ImageView
                        android:id="@+id/btForward_5"
                        android:layout_width="@dimen/margin_50"
                        android:layout_height="@dimen/margin_50"
                        android:padding="@dimen/padding_15"
                        android:src="@drawable/ic_forward_five"/>
                    <ImageView
                        android:id="@+id/exo_bt_rotate"
                        android:layout_width="@dimen/margin_30"
                        android:layout_height="@dimen/margin_30"
                        android:src="@drawable/ic_phone_rotate"
                        android:padding="@dimen/padding_5"
                        android:layout_margin="@dimen/margin_15"/>

                    <ImageButton
                        android:id="@+id/exo_next"
                        style="@style/ExoStyledControls.Button.Center.Next"
                        android:visibility="gone"/>

                    <View
                        android:id="@+id/dummy"
                        style="@style/ExoStyledControls.Button.Center.Secondary" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/exo_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/padding_10"
                    android:paddingEnd="@dimen/padding_10"
                    android:layoutDirection="ltr">

                    <TextView
                        android:id="@+id/exo_position"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/white_color" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/white_color"/>

                    <TextView
                        android:id="@+id/exo_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textSize="@dimen/text_12"
                        android:textColor="@color/white_color"/>

                </LinearLayout>
                <com.growmore.firebrowser.player.CustomDefaultTimeBar
                    android:id="@+id/exo_progress"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_30"
                    android:layout_gravity="bottom"
                    app:bar_gravity="center"
                    app:bar_height="@dimen/margin_5"
                    android:layout_marginBottom="@dimen/margin_10"
                    app:scrubber_dragged_size="@dimen/margin_15"
                    app:scrubber_enabled_size="@dimen/margin_10"
                    app:touch_target_height="@dimen/margin_40"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>