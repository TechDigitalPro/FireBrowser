<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bk_linear_overlay">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/transparent_color"
            android:theme="@style/AppTheme.AppBarOverlay"
            app:elevation="0dp">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                <LinearLayout
                    android:id="@+id/toolbarView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:id="@+id/toolbarHeader"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:visibility="visible">
                        <ImageView
                            android:layout_width="?attr/actionBarSize"
                            android:layout_height="?attr/actionBarSize"
                            android:padding="@dimen/padding_12"
                            android:src="@drawable/ic_fire"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_20"
                            android:textColor="@color/white_color"
                            android:text="@string/app_name"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/toolbarBrowse"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <ImageView
                            android:id="@+id/toolbarBrowseBack"
                            android:layout_width="@dimen/bottom_icon_size"
                            android:layout_height="@dimen/bottom_icon_size"
                            android:padding="@dimen/padding_5"
                            android:src="@drawable/ic_arrow_back"/>
                        <ImageView
                            android:id="@+id/toolbarBrowseForward"
                            android:layout_width="@dimen/bottom_icon_size"
                            android:layout_height="@dimen/bottom_icon_size"
                            android:padding="@dimen/padding_5"
                            android:src="@drawable/ic_arrow_next"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_margin="@dimen/margin_5"
                            android:paddingStart="@dimen/padding_5"
                            android:paddingEnd="@dimen/padding_5"
                            android:background="@drawable/bk_search_bar">
                            <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                                android:id="@+id/toolbarBrowseSearch"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:padding="@dimen/margin_10"
                                android:hint="@string/txt_watch_free_videos"
                                android:textColor="@color/white_color"
                                android:textColorHint="@color/grey_light"
                                android:background="@android:color/transparent"
                                android:imeOptions="actionDone"
                                android:inputType="textUri"
                                android:singleLine="true"
                                android:selectAllOnFocus="true"
                                android:ellipsize="start"
                                android:textSize="@dimen/text_12"/>
                            <ImageView
                                android:id="@+id/toolbarBrowseSearchReload"
                                android:layout_width="@dimen/bottom_icon_size"
                                android:layout_height="@dimen/bottom_icon_size"
                                android:padding="@dimen/padding_5"
                                android:src="@drawable/ic_reload"/>
                        </LinearLayout>

                    </LinearLayout>
                    <ImageView
                        android:id="@+id/toolbarTabs"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:padding="@dimen/padding_10"
                        android:src="@drawable/ic_tabs"
                        android:visibility="gone"/>
                    <ImageView
                        android:id="@+id/toolbarMore"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:padding="@dimen/padding_10"
                        android:src="@drawable/ic_more_3_dot"/>
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <FrameLayout
                android:id="@+id/mainContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/margin_20">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/margin_50"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/margin_20"
                    android:paddingStart="@dimen/margin_5"
                    android:paddingEnd="@dimen/margin_5"
                    android:background="@drawable/bk_search_bar_stroke">
                    <ImageView
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:padding="@dimen/padding_10"
                        android:src="@drawable/ic_search"/>
                    <TextView
                        android:id="@+id/mainSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="@dimen/margin_10"
                        android:hint="@string/txt_search_or_browse_video_site"
                        android:textColor="@color/white_color"
                        android:textColorHint="@color/grey_light"
                        android:background="@android:color/transparent"
                        android:singleLine="true"
                        android:selectAllOnFocus="true"
                        android:ellipsize="start"
                        android:textSize="@dimen/text_15"/>
                    <ImageView
                        android:id="@+id/btVoice"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:padding="@dimen/padding_10"
                        android:src="@drawable/ic_mic_white"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20"
                    android:layout_marginBottom="@dimen/margin_20"
                    android:scrollbars="none"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <RelativeLayout
        android:id="@+id/lvCoverView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_trans_back"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"/>
</RelativeLayout>