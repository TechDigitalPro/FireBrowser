<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/colorPrimaryDark">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/transparent_color"
                android:theme="@style/AppTheme.AppBarOverlay"
                app:elevation="0dp">
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:contentInsetLeft="0dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light">
                    <LinearLayout
                        android:id="@+id/toolbarView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:id="@+id/toolbarHeader"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:visibility="visible">
                            <ImageView
                                android:layout_width="?attr/actionBarSize"
                                android:layout_height="?attr/actionBarSize"
                                android:padding="@dimen/padding_12"
                                android:src="@drawable/ic_fire"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textSize="@dimen/text_20"
                                android:textColor="@color/white_color"
                                android:text="@string/txt_fire_vpn"/>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/toolbarTabs"
                            android:layout_width="@dimen/sidebar_icon_size"
                            android:layout_height="@dimen/sidebar_icon_size"
                            android:padding="@dimen/padding_10"
                            android:src="@drawable/ic_location"/>
                        <ImageView
                            android:id="@+id/toolbarMore"
                            android:layout_width="@dimen/sidebar_icon_size"
                            android:layout_height="@dimen/sidebar_icon_size"
                            android:padding="@dimen/padding_10"
                            android:src="@drawable/ic_more_3_dot"/>
                    </LinearLayout>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.AppBarLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_centerInParent="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="@dimen/text_15"
                        android:textColor="@color/grey_light"
                        android:text="@string/txt_not_connected"/>
                    <ImageView
                        android:layout_width="@dimen/margin_120"
                        android:layout_height="@dimen/margin_120"
                        android:layout_margin="@dimen/margin_20"
                        android:src="@drawable/ic_disconnected"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="@dimen/text_15"
                        android:textColor="@color/grey_light"
                        android:text="@string/txt_auto_connect_server"
                        app:drawableStartCompat="@drawable/ic_location"
                        app:drawableEndCompat="@drawable/ic_arrow_next"
                        android:drawablePadding="@dimen/padding_15"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_20"
                    android:layout_marginEnd="@dimen/margin_20"
                    android:layout_marginBottom="@dimen/margin_40"
                    android:gravity="center"
                    android:layout_alignParentBottom="true"
                    android:textSize="@dimen/text_12"
                    android:textColor="@color/grey_dark"
                    android:text="@string/txt_tap_to_connect_the_fire_vpn_and_keep_your_browsing_more_secure_and_anonymous"/>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/lvCoverView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/grey_trans_back"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>
    </RelativeLayout>

</LinearLayout>