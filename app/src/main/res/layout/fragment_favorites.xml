<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"/>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/lvBlankView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:visibility="visible">
        <ImageView
            android:layout_width="@dimen/empty_image_size"
            android:layout_height="@dimen/empty_image_size"
            android:src="@drawable/ic_empty_favorite"
            android:layout_margin="@dimen/margin_20"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/text_15"
            android:textColor="@color/grey_light"
            android:textStyle="bold"
            android:text="No favorites"
            android:layout_margin="@dimen/margin_10"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/text_12"
            android:textColor="@color/grey_light"
            android:text="@string/txt_favorite_videos_will_be_displayed_here_when_you_add_your_downloaded_videos_to_favorite"
            android:layout_marginStart="@dimen/margin_20"
            android:layout_marginEnd="@dimen/margin_20"/>
        <TextView
            android:id="@+id/btHowToDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_10"
            android:layout_margin="@dimen/margin_20"
            android:gravity="center"
            android:background="@drawable/bk_button_gradient_rect"
            android:textSize="@dimen/text_15"
            android:textColor="@color/white_color"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:text="@string/txt_how_to_download"
            android:visibility="invisible"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/lvCoverView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_trans_back"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"/>
</RelativeLayout>