<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/padding_10"
    android:background="@color/colorPrimaryDark">
    <ImageView
        android:id="@+id/imgNotification"
        android:layout_width="@dimen/item_link_image_size"
        android:layout_height="@dimen/item_link_image_size"
        android:src="@drawable/ic_fire"/>

    <LinearLayout
        android:id="@+id/lvProgressNotification"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/margin_10"
        android:visibility="visible">
        <TextView
            android:id="@+id/tvBigTitleNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/white_color"
            android:textSize="@dimen/text_15"
            android:text="@string/app_name"/>
        <ProgressBar
            android:id="@+id/itemProgressBarNotification"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_5"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bk_progress_bar"
            android:visibility="visible"
            android:layout_marginTop="@dimen/margin_3"
            android:layout_marginBottom="@dimen/margin_3"/>
        <TextView
            android:id="@+id/tvSizeNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/grey_light"
            android:textSize="@dimen/text_12"
            android:text="@string/app_name"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/lvCompletedNotification"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_10">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/white_color"
                android:textSize="@dimen/text_15"
                android:text="@string/txt_download_complete"/>
            <TextView
                android:id="@+id/tvSmallTitleNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/grey_light"
                android:textSize="@dimen/text_12"
                android:text="@string/app_name"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/btPlayNotification"
            android:layout_width="@dimen/sidebar_icon_size"
            android:layout_height="@dimen/sidebar_icon_size"
            android:padding="@dimen/padding_5"
            android:src="@drawable/ic_play"
            app:tint="@color/colorAccent" />
    </LinearLayout>

</LinearLayout>