<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_splash_back">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@+id/lvName"
        android:layout_marginBottom="@dimen/margin_20"
        android:textSize="@dimen/text_15"
        android:textColor="@color/white_color"
        android:text="@string/txt_welcome_to"/>
    <LinearLayout
        android:id="@+id/lvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white_color"
            android:textStyle="bold"
            android:textSize="@dimen/text_35"
            android:text="@string/txt_fire"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white_color"
            android:textStyle="bold"
            android:textSize="@dimen/text_35"
            android:text="@string/txt_browser"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lvStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="@dimen/margin_20"
        android:layout_marginEnd="@dimen/margin_20"
        android:layout_marginBottom="@dimen/margin_50"
        android:layout_alignParentBottom="true">
        <TextView
            android:id="@+id/btStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_10"
            android:layout_marginBottom="@dimen/margin_10"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/bk_button_gradient_rect"
            android:textColor="@color/white_color"
            android:textAllCaps="true"
            android:textSize="@dimen/text_18"
            android:text="@string/txt_starts"/>
        <TextView
            android:id="@+id/btSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_5"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/white_color"
            android:textSize="@dimen/text_15"
            android:text="@string/txt_skip"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white_color"
            android:textSize="@dimen/text_15"
            android:text="@string/txt_and_accept_default_privacy_settings"/>
    </LinearLayout>

</RelativeLayout>